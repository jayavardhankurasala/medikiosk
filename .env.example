# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL / Supabase / Neon / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medikiosk?schema=public"

# Google Gemini API
GEMINI_API_KEY="your_gemini_api_key_here"

# Authentication & Security
JWT_SECRET="medikiosk_super_secure_jwt_secret_change_in_production_2026"
JWT_EXPIRES_IN="12h"

# SMS OTP Service (Twilio / Fast2SMS / Mock)
SMS_PROVIDER="MOCK" # Options: MOCK, FAST2SMS, TWILIO
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
FAST2SMS_API_KEY=""

# Upload directory
UPLOAD_DIR="./uploads"
