# ==============================================================================
# MediKiosk Backend Environment Configuration Template
# Copy this file to `.env` in this directory and configure your credentials.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production                     # 'production' or 'development'
FRONTEND_URL=http://localhost:5173     # Used for CORS in development

# Database Configuration (PostgreSQL / Supabase / Neon / AWS RDS)
# Local Docker: postgresql://postgres:postgres@localhost:5432/medikiosk?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medikiosk?schema=public"

# Google Gemini API Key (Required for AI multimodal case-taking & document OCR)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Authentication & Security
# Generate a cryptographically secure random secret for production (e.g. openssl rand -hex 32)
JWT_SECRET="medikiosk_super_secure_jwt_secret_change_in_production_2026"
JWT_EXPIRES_IN="12h"

# SMS OTP Service (Twilio / Fast2SMS / Mock)
# Set to 'MOCK' for testing (OTP printed to server console)
SMS_PROVIDER="MOCK" # Options: MOCK, FAST2SMS, TWILIO

# Twilio Credentials (Required only if SMS_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Fast2SMS Credentials (Required only if SMS_PROVIDER=FAST2SMS - India only)
FAST2SMS_API_KEY=""

# Static Uploads Directory
UPLOAD_DIR="./uploads"
